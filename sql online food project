--  Display all customers
SELECT *
FROM Customer;

-- Customers from Coimbatore 
SELECT *
FROM Customer
WHERE city = 'Coimbatore';

-- Restaurants with rating above 4.3  
SELECT *
FROM Restaurant
WHERE rating > 4.3;

-- Food items below ₹200
SELECT *
FROM Menu
WHERE price < 200;

-- Biryani items
SELECT *
FROM Menu
WHERE category = 'Biryani';

-- Total number of customers
SELECT COUNT(*) AS total_customers
FROM Customer;

-- Total orders
SELECT COUNT(*) AS total_orders
FROM Orders;

-- Total sales
SELECT SUM(total_amount) AS total_sales
FROM Orders;

-- Average order value
SELECT AVG(total_amount) AS average_order_value
FROM Orders;

-- Highest order amount
SELECT MAX(total_amount) AS highest_order
FROM Orders;

-- Number of restaurants in each city
SELECT city, COUNT(*) AS restaurant_count
FROM Restaurant
GROUP BY city;

-- Show customer and their orders
SELECT
    c.customer_name,
    o.order_id,
    o.order_date,
    o.total_amount
FROM Customer c
JOIN Orders o
ON c.customer_id = o.customer_id;

-- Show food ordered by customers
SELECT
    c.customer_name,
    m.food_name,
    o.quantity,
    o.total_amount
FROM Customer c
JOIN Orders o
ON c.customer_id = o.customer_id
JOIN Menu m
ON o.menu_id = m.menu_id;

-- show restaurant and orders
SELECT
    r.restaurant_name,
    o.order_id,
    o.total_amount
FROM Restaurant r
JOIN Orders o
ON r.restaurant_id = o.restaurant_id;



-- Show customer and their orders
SELECT
    c.customer_name,
    o.order_id,
    o.order_date,
    o.total_amount
FROM Customer c
JOIN Orders o
ON c.customer_id = o.customer_id;
-- Show food ordered by customers
SELECT
    c.customer_name,
    m.food_name,
    o.quantity,
    o.total_amount
FROM Customer c
JOIN Orders o
ON c.customer_id = o.customer_id
JOIN Menu m
ON o.menu_id = m.menu_id;
-- show restaurant and orders
SELECT
    r.restaurant_name,
    o.order_id,
    o.total_amount
FROM Restaurant r
JOIN Orders o
ON r.restaurant_id = o.restaurant_id;

-- Monthly sales report
SELECT
    YEAR(order_date) AS year,
    MONTH(order_date) AS month,
    SUM(total_amount) AS monthly_sales
FROM Orders
GROUP BY YEAR(order_date), MONTH(order_date)
ORDER BY year, month;

-- Customer rating report
SELECT
    c.customer_name,
    AVG(f.rating) AS average_rating,
    COUNT(f.feedback_id) AS feedback_count
FROM Customer c
JOIN Feedback f
ON c.customer_id = f.customer_id
GROUP BY c.customer_name
ORDER BY average_rating DESC;

-- Restaurant performance analysis
SELECT
    r.restaurant_name,
    COUNT(o.order_id) AS total_orders,
    SUM(o.total_amount) AS total_sales,
    AVG(o.total_amount) AS average_order_value
FROM Restaurant r
JOIN Orders o
ON r.restaurant_id = o.restaurant_id
GROUP BY r.restaurant_name
ORDER BY total_sales DESC;

-- Most ordered food items
SELECT
    m.food_name,
    SUM(o.quantity) AS total_quantity
FROM Menu m
JOIN Orders o
ON m.menu_id = o.menu_id
GROUP BY m.food_name
ORDER BY total_quantity DESC;

-- Top 5 restaurants by revenue
SELECT
    r.restaurant_name,
    SUM(o.total_amount) AS revenue
FROM Restaurant r
JOIN Orders o
ON r.restaurant_id = o.restaurant_id
GROUP BY r.restaurant_name
ORDER BY revenue DESC
LIMIT 5;

-- Pending payments
SELECT
    o.order_id,
    c.customer_name,
    p.amount,
    p.payment_status
FROM Orders o
JOIN Customer c
ON o.customer_id = c.customer_id
JOIN Payment p
ON o.order_id = p.order_id
WHERE p.payment_status = 'Pending';

 -- Customers who spent more than ₹5,000
SELECT
    c.customer_name,
    SUM(o.total_amount) AS total_spent
FROM Customer c
JOIN Orders o
ON c.customer_id = o.customer_id
GROUP BY c.customer_name
HAVING SUM(o.total_amount) > 5000;

-- Cancelled order
SELECT COUNT(*) AS cancelled_orders
FROM Orders
WHERE order_status = 'Cancelled';

-- successfull orders
SELECT COUNT(*) AS successful_orders
FROM Orders
WHERE order_status = 'Delivered';

-- To categorize the order
SELECT
    order_id,
    total_amount,
    CASE
        WHEN total_amount >= 500 THEN 'High Value'
        WHEN total_amount >= 250 THEN 'Medium Value'
        ELSE 'Low Value'
    END AS order_category
FROM Orders;

-- Find restaurants with rating higher than average restaurant rating
SELECT
    restaurant_name,
    rating
FROM Restaurant
WHERE rating > (
    SELECT AVG(rating)
    FROM Restaurant
);


-- Customers who spent more than ₹500
SELECT
    c.customer_name,
    SUM(o.total_amount) AS total_spent
FROM Customer c
JOIN Orders o
ON c.customer_id = o.customer_id
WHERE o.order_status = 'Delivered'
GROUP BY c.customer_name
HAVING SUM(o.total_amount) > 500;


-- Restaurant sales using CTE
WITH RestaurantSales AS (
    SELECT
        restaurant_id,
        SUM(total_amount) AS total_sales
    FROM Orders
    WHERE order_status = 'Delivered'
    GROUP BY restaurant_id
)
SELECT
    r.restaurant_name,
    rs.total_sales
FROM Restaurant r
JOIN RestaurantSales rs
ON r.restaurant_id = rs.restaurant_id
ORDER BY rs.total_sales DESC;

-- Top 5 Food Items
SELECT
    m.food_name,
    SUM(o.quantity) AS total_quantity
FROM Menu m
JOIN Orders o
ON m.menu_id = o.menu_id
WHERE o.order_status = 'Delivered'
GROUP BY m.food_name
ORDER BY total_quantity DESC
LIMIT 5;

-- Payment method usage
SELECT
    payment_method,
    COUNT(*) AS payment_count
FROM Payment
GROUP BY payment_method
ORDER BY payment_count DESC;

-- failed payments
SELECT
    p.payment_id,
    o.order_id,
    p.amount,
    p.payment_status
FROM Payment p
JOIN Orders o
ON p.order_id = o.order_id
WHERE p.payment_status = 'Failed';

-- Restaurants and their customer ratings
SELECT
    r.restaurant_name,
    AVG(f.rating) AS average_customer_rating
FROM Restaurant r
JOIN Orders o
ON r.restaurant_id = o.restaurant_id
JOIN Feedback f
ON o.order_id = f.order_id
GROUP BY r.restaurant_name
ORDER BY average_customer_rating DESC;

-- Find restaurants with no orders:
SELECT
    r.restaurant_id,
    r.restaurant_name
FROM Restaurant r
LEFT JOIN Orders o
ON r.restaurant_id = o.restaurant_id
WHERE o.order_id IS NULL;

-- Rating distribution
SELECT
    rating,
    COUNT(*) AS rating_count
FROM Feedback
GROUP BY rating
ORDER BY rating DESC;
